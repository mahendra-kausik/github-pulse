[sqlfluff]
# jinja (not dbt) templater: lints with zero BigQuery connection or `dbt deps`, using
# apply_dbt_builtins to stub ref()/source()/config()/var() — this project's whole Jinja surface.
templater = jinja
dialect = bigquery
# LT05: allow long lines in generated SQL. RF04: allow keywords as identifiers.
exclude_rules = LT05, RF04

[sqlfluff:templater:jinja]
apply_dbt_builtins = True

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower
